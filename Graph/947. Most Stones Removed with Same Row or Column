class Solution {
public:
    void dfs(vector<vector<int>>& stones,int ind,vector<bool>& vis)
    {
        vis[ind]=true;

        for(int i=0;i<stones.size();i++)
        {
            if(vis[i]==false && (stones[i][0]==stones[ind][0] || stones[i][1]==stones[ind][1])){
                dfs(stones,i,vis);
            }
        
        }
    }
    int removeStones(vector<vector<int>>& stones) {
        int n=stones.size();

        vector<bool>vis(n,false);
        int group=0;
        for(int i=0;i<n;i++)
        {
            if(vis[i]==true)
            continue;

            dfs(stones,i,vis);
            group++;
        }

        return n-group;
    }
};